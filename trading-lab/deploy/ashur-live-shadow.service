[Unit]
Description=ASHUR live paper-trading worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ashur
Group=ashur
WorkingDirectory=/opt/ashur
Environment=PYTHONUNBUFFERED=1
Environment=ASHUR_INTERVAL_SECONDS=300
Environment=ASHUR_GIT_BRANCH=ashur-live-shadow
ExecStart=/opt/ashur/.venv/bin/python /opt/ashur/trading-lab/ashur_daemon.py
Restart=always
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ashur

[Install]
WantedBy=multi-user.target
