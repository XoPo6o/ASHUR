{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "ASHUR-Freqtrade-Evaluation",
  "initial_state": "stopped",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": 1000,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "trading_mode": "spot",
  "margin_mode": "",
  "timeframe": "15m",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes",
    "exit_timeout_count": 0
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "price_last_balance": 0
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "price_last_balance": 0
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BNB/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "jwt_secret_key": "replace-this-with-a-long-random-secret",
    "ws_token": "replace-this-with-a-long-random-secret",
    "CORS_origins": [],
    "username": "disabled",
    "password": "disabled"
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
